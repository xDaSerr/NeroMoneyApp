rules_version = '2';

// Regla base de NeroMoney: cada usuario solo puede leer/escribir sus propios
// datos (cuentas, transacciones, config del asistente, etc.), nunca los de
// otro usuario. Todo vive bajo /usuarios/{uid}/... ligado a su Firebase Auth UID.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Membresía (la escribe solo el webhook de Polar) y contador de mensajes
    // de IA (lo escribe solo interpretarMensajeIA). El usuario puede verlos,
    // nunca cambiarlos: si pudiera, se daría Pro gratis.
    match /suscripciones/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /usoIA/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Resúmenes mensuales de la IA: los escribe solo resumenMensualIA (así
    // nadie se salta el "uno al día" borrando su copia).
    match /resumenesIA/{uid}/meses/{mes} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Respaldos mensuales (Pro): los escribe solo el servidor.
    match /respaldos/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Tipos de cambio (multimoneda): los renueva el servidor, todos los
    // usuarios con sesión los leen.
    match /tiposCambio/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Gastos compartidos (Pro). Solo los miembros ven el grupo y escriben
    // sus gastos y metas. Crear, unirse y salir lo hacen las Cloud Functions
    // (crearGrupo, unirseAGrupo, salirDeGrupo): el cliente nunca cambia la
    // lista de miembros, que es lo que da acceso.
    function esMiembro(grupoId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/grupos/$(grupoId)).data.miembros;
    }
    match /grupos/{grupoId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.miembros;
      allow write: if false;
    }
    match /grupos/{grupoId}/{coleccion}/{docId} {
      allow read, delete: if esMiembro(grupoId);
      allow create, update: if coleccion in ['gastos', 'metas'] &&
        esMiembro(grupoId);
    }
    // Código de invitación → grupo: solo lo leen las funciones.
    match /codigosGrupo/{codigo} {
      allow read, write: if false;
    }

    // Cualquier otra ruta queda cerrada por defecto (deny-by-default).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
